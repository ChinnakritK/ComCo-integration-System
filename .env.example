# Optional overrides for docker-compose.yml (copy to .env). Defaults work out of the box.
LOG_LEVEL=INFO
CUSTOMER_DB_PASSWORD=customer_pw
ORDER_DB_PASSWORD=order_pw
# Demo-only request headers X-Simulate-Delay-Ms / X-Simulate-Status. Set to false to disable.
FAULT_INJECTION_ENABLED=true
# Agent identity at the gateway (must match gateway/kong.yml)
AGENT_API_KEY=agent-platform-key
# Optional local LLM planner: docker compose --profile llm up -d, then pull the model
USE_LLM=false
OLLAMA_MODEL=llama3.2:3b
# Coordinator execution: a2a (delegate to Customer/Order agents) or direct (call APIs itself)
EXECUTION_MODE=a2a
CUSTOMER_AGENT_API_KEY=customer-agent-key
ORDER_AGENT_API_KEY=order-agent-key
